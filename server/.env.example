NODE_ENV=development
PORT=5000
# Use an initialized replica set, or a MongoDB Atlas connection URI.
MONGO_URI=mongodb://127.0.0.1:27017/financial_crm_dev?replicaSet=rs0
CLIENT_URL=http://localhost:5173
# Generate two DIFFERENT random secrets of at least 32 characters.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Optional local DEMO reset only. Leave disabled for normal use.
# SEED_DATABASE_NAME=financial_crm_dev
# SEED_ALLOW_RESET=DELETE_DEMO_DATA
# DEMO_PASSWORD=

# Live transactional email (worker runs separately)
RESEND_API_KEY=
MAIL_FROM=
# Set only to the exact number of trusted reverse proxies in your deployment.
TRUST_PROXY_HOPS=
